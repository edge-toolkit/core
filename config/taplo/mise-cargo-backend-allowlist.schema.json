{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mise [tools] -- cargo backend allowlist",
  "description": "`cargo:` source build; tools with no prebuilt + os-scoped fallbacks (findutils, ryl).",
  "type": "object",
  "properties": {
    "tools": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          { "not": { "pattern": "^cargo:" } },
          {
            "enum": [
              "cargo:action-validator",
              "cargo:aube",
              "cargo:cargo-expand",
              "cargo:dart-typegen",
              "cargo:findutils",
              "cargo:open",
              "cargo:ryl",
              "cargo:wasm-opt"
            ]
          }
        ]
      }
    }
  }
}
