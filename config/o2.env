RUST_LOG=warn
ZO_ROOT_USER_EMAIL=root@example.com
# OpenObserve enforces a password policy at startup and aborts the container when it is not met.
# The abort is fatal and reads: "ZO_ROOT_USER_PASSWORD is too weak: Password must be 8-128 characters and
# contain at least one lowercase letter, one uppercase letter, one digit, and one special character."
# This is a local dev-only credential, so it is committed deliberately; keep any replacement inside the policy.
# The pragma sits on its own line because an env file has no inline comments: docker's --env-file keeps
# everything after the `=` verbatim, so a trailing `# skipcq` would become part of the password itself.
# skipcq: SCT-A000 -- local dev-only credential, committed deliberately
ZO_ROOT_USER_PASSWORD=Complexpass#123
