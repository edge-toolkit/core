{#
  The scenario image, which layers the cluster's modules onto the hub image.

  Every list it is rendered from is sorted, since resolution order moves a module whenever an unrelated one gains a
  dependency, and this file is committed. Each stage ends with its own blank line, so none starts with one; doing it
  the other way round doubles the separator wherever two stages meet.
#}
# syntax=docker/dockerfile:1

# AUTO-GENERATED by `et-cli` for the `{{ name }}` scenario -- do not edit.
# Regenerate with `mise run regen-verification`.
#
# The hub image ({{ hub_dockerfile }}) carries no workflow modules at all, because which
# modules a deployment serves is a per-cluster decision. This image is that decision made concrete: it
# stages exactly the modules this cluster's agents declare, plus the packages those modules depend on,
# into the `/app` paths the hub already scans.
#
{#
  A published image copies nothing out of a checkout, so the ignore file that re-admits built artifacts has no part in
  it; what it says instead is where its modules come from.
#}
{% if published %}
# This scenario consumes the project's releases, so its modules are fetched from the registry they are
# published to rather than copied from a checkout, and the image builds from the deployment directory
# alone.
{% else %}
# The sibling `Dockerfile.dockerignore` is what makes the COPYs below possible. The repository's root
# `.dockerignore` drops every `*.wasm` and `*.onnx` so the CI images built from `./Dockerfile` stay
# small; BuildKit uses this Dockerfile's own ignore file instead, which re-admits the built `pkg/`
# directories and nothing else.
{% endif %}

{% if mise_tools %}
{#
  The stage that installs the mise-staged packages the cluster's modules depend on.

  The repo's own `.mise/` configs and lockfiles are the version source, so nothing here pins a version that could drift
  from what a workstation resolves; only the tool ids come from the module registry.
#}
# Stage the packages that live outside the repository.
# These are published packages the modules load at runtime, provisioned by mise rather than built
# here, so this stage installs them from the repo's own pins and copies each one to the `/app` path
# the hub serves it from.
FROM docker.io/library/debian:bookworm-slim AS deps

# The package list is named rather than inlined so a policy can hold it against the repo-root Dockerfile.
# Every name here is drawn from that file's own COMMON_PACKAGES: the shell, the archive tools mise unpacks
# downloads with, plus git and curl. Its compiler packages are deliberately absent -- nothing is compiled
# in this stage -- so the two lists are checked as subset rather than equality.
# Promoted to ENV because the quoted heredoc below is expanded by bash at run time, which an ARG alone
# does not reach.
ARG COMMON_PACKAGES="bash bzip2 ca-certificates curl git gzip tar unzip"
ENV COMMON_PACKAGES=${COMMON_PACKAGES}
RUN bash <<'EOF'
set -euo pipefail
apt-get update
# Word-splitting $COMMON_PACKAGES into separate arguments is the intent, so it is deliberately unquoted.
apt-get install -y --no-install-recommends $COMMON_PACKAGES
apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
EOF

# mise is fetched to a file and checksum-verified, never piped from mise.run into a shell.
# Piping a remote script into an interpreter runs unreviewed code straight off the network, which the
# repo's no-curl-pipe rule bans. The release's SHASUMS256.txt covers every asset, so `--ignore-missing`
# checks exactly the archive downloaded here. Pinned rather than installed from mise's apt repository,
# which carries only the newest version: a floating mise writes lockfile entries an older CI mise
# then refuses to install.
ARG MISE_VERSION=v2026.10.15
ARG TARGETARCH
ENV MISE_VERSION=${MISE_VERSION}
ENV TARGETARCH=${TARGETARCH}
RUN bash <<'EOF'
set -euo pipefail
case "${TARGETARCH}" in
    amd64) arch=x64 ;;
    arm64) arch=arm64 ;;
    *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;;
esac
asset="mise-${MISE_VERSION}-linux-${arch}.tar.gz"
base="https://github.com/jdx/mise/releases/download/${MISE_VERSION}"
cd /tmp
curl -fsSL -o "${asset}" "${base}/${asset}"
curl -fsSL -o SHASUMS256.txt "${base}/SHASUMS256.txt"
sha256sum -c --ignore-missing SHASUMS256.txt
tar -xzf "${asset}"
install -m 0755 /tmp/mise/bin/mise /usr/local/bin/mise
rm -rf /tmp/mise "/tmp/${asset}" /tmp/SHASUMS256.txt
EOF

ENV HOME=/root
ENV PATH="/root/.local/share/mise/shims:${PATH}"
WORKDIR /workspace
COPY .miserc.toml .miserc.toml
COPY .mise/ .mise/
RUN mise trust
ENV MISE_ENV={{ deps_mise_env }}
{%     if installs_node %}
{#
  mise's npm backend shells out to npm, and refuses an `npm:` tool whose configured `node` dependency is not installed
  yet ("requires configured install dependency 'node@22', but its selected version is not installed"). Its version
  comes from the repo's own [tools] pin, like every other tool staged here. The blank line after `EOF` is load-bearing,
  not formatting. hadolint's parser reads the next instruction as a continuation of the heredoc without it and fails
  with `unexpected 'E' expecting a new line followed by the next instruction`.
#}
RUN bash <<'EOF'
set -euo pipefail
mise install node
EOF

{%     endif %}
ENV SCENARIO_TOOLS="{{ mise_tools | map(attribute="tool") | join(" ") }}"
RUN bash <<'EOF'
set -euo pipefail
# Word-splitting SCENARIO_TOOLS is intentional; it is a space-separated tool list.
# shellcheck disable=SC2086
mise install ${SCENARIO_TOOLS}
EOF

{#
  Each package is located rather than assuming where the backend put it. The npm backend nests it under one of several
  layouts (`lib/node_modules/`, `node_modules/`, or an aube virtual store below a content-hashed directory) that vary by
  platform, so the copy searches for the named directory instead. The named directory is tried FIRST and the install
  root only as a fallback: the npm backend drops its own wrapper manifest (`"name": "mise-npm-install"`) at that root,
  so a root-first probe stages the wrapper and the module is then served under the wrapper's name. The fallback is what
  covers an archive-backed `http:` tool, which extracts flat so the root really is the package. `-L` and `cp -L`
  resolve the symlinks the aube store is built from, so real files land in the image.
#}
{%     for tool in mise_tools %}
ENV STAGE_TOOL="{{ tool.tool }}"
ENV STAGE_PACKAGE="{{ tool.package }}"
ENV STAGE_DEST="/staged{{ tool.docker_path }}"
RUN bash <<'EOF'
set -euo pipefail
root="$(mise where "${STAGE_TOOL}")"
src="$(find -L "${root}" -type d -name "${STAGE_PACKAGE}" -exec test -f '{}/package.json' ';' -print -quit)"
if [ -z "${src}" ] && [ -f "${root}/package.json" ]; then
    src="${root}"
fi
if [ -z "${src}" ]; then
    echo "no ${STAGE_PACKAGE} package dir under the ${STAGE_TOOL} install at ${root}" >&2
    exit 1
fi
mkdir -p "$(dirname "${STAGE_DEST}")"
cp -rL "${src}" "${STAGE_DEST}"
EOF

{%     endfor %}
{% endif %}
{% if released %}
{#
  The stage that fetches this repository's modules from the registry a published scenario consumes them from.

  `npm pack` rather than a download by URL, because it checks each tarball against the integrity the registry records
  for it before writing it. The tarball holds the module's `pkg/` exactly as it was published, under npm's `package/`
  prefix, which the extraction strips. The token reaches the step as a secret mount, never as a build argument or a
  file in a layer, and the npm config only names it. It is written one `printf` per line, appending, so no line of the
  step outgrows the file's width.
#}
# Fetch the released modules this scenario serves.
# GitHub Packages refuses an anonymous read even of a public package, so the build takes a `gh_token`
# secret, which is only ever mounted into the step that needs it.
FROM {{ node_image }} AS released

ENV NPM_CONFIG_USERCONFIG=/released.npmrc
RUN bash <<'EOF'
set -euo pipefail
{%     for line in npmrc | lines %}
printf '%s\n' '{{ line }}' >> /released.npmrc
{%     endfor %}
EOF

{%     for module in released %}
ENV STAGE_PACKAGE="{{ module.package }}"
ENV STAGE_DEST="/staged{{ module.docker_path }}/pkg"
RUN --mount=type=secret,id={{ token_secret }},env={{ token_env }} bash <<'EOF'
set -euo pipefail
cd /tmp
tarball="$(npm pack --silent "${STAGE_PACKAGE}@latest")"
mkdir -p "${STAGE_DEST}"
tar -xzf "${tarball}" -C "${STAGE_DEST}" --strip-components=1
rm "${tarball}"
EOF

{%     endfor %}
{% endif %}
{% if published %}
# The released hub image, which this scenario layers its modules onto.
# `latest` because that is the one tag the hub is published under: it is assembled from each
# architecture's build, so a node of either architecture resolves it. That is why the rule against
# a `latest` base is suppressed on the next line.
# hadolint ignore=DL3007
FROM {{ registry }}/et-ws-server:latest
{% else %}
# `hub` is a named build context, not a stage defined here.
# The generated compose file wires it to its `{{ hub_image_build }}` service, so compose builds the hub image
# first and hands the result over under this name. That is also why the version-tag rule is
# suppressed on the next line: hadolint reads `hub` as an untagged image, but there is no tag to give a
# build context, and the image it resolves to is pinned by the hub Dockerfile rather than here.
# hadolint ignore=DL3006
FROM hub
{% endif %}

LABEL org.opencontainers.image.source="{{ repository_url }}"

{#
  `pkg/` unconditionally, never probed for on disk. Every module serves out of `pkg/`, whether that directory is
  committed (the JS shims) or produced by a build (wasm-pack output, wheels). Probing for it makes this file depend on
  what happens to be built in the working tree: CI checks out unbuilt Rust modules, found no
  `services/ws-modules/har1/pkg`, and emitted the module root instead -- so the committed output and the CI regeneration
  disagreed, and the drift check failed. A module that genuinely has no `pkg/` now fails loudly at image build rather
  than silently generating a different Dockerfile per machine.
#}
{% for module in repo_paths %}
COPY --chown=10001:10001 {{ module.repo_path }}/pkg {{ module.docker_path }}/pkg
{% endfor %}
{# One copy of the whole staged tree, which mirrors `/app` path for path. #}
{% if released %}
COPY --from=released --chown=10001:10001 /staged/app /app
{% endif %}
{% for tool in mise_tools %}
COPY --from=deps --chown=10001:10001 /staged{{ tool.docker_path }} {{ tool.docker_path }}
{% endfor %}
{#
  Each from the named build context its `module_paths:` entry is handed to the build as, and whole rather than its
  `pkg/`: whether the module serves from `pkg/` or its root is the scenario author's layout, and the hub finds either
  once the directory is there. hadolint reads a context name as an undefined stage, as with `hub` above.
#}
{% for module in scenario_dirs %}
# hadolint ignore=DL3022
COPY --from={{ module.context }} --chown=10001:10001 [{{ module.source }}, {{ module.destination }}]
{% endfor %}
{#
  The user the hub image already runs as, restated so the image says so itself rather than only through a base a
  scanner cannot see into; every COPY above hands its files to the same id. An image with no COPY already ends in the
  blank line that closes its LABEL.
#}
{% if repo_paths or released or mise_tools or scenario_dirs %}

{% endif %}
USER 10001
