# syntax=docker/dockerfile:1

# AUTO-GENERATED by `et-cli` for the `facility-security-scenario` scenario -- do not edit.
# Regenerate with `mise run regen-verification`.
#
# The hub image (services/ws-server/Dockerfile) carries no workflow modules at all, because which
# modules a deployment serves is a per-cluster decision. This image is that decision made concrete: it
# stages exactly the modules this cluster's agents declare, plus the packages those modules depend on,
# into the `/app` paths the hub already scans.
#
# The sibling `Dockerfile.dockerignore` is what makes the COPYs below possible. The repository's root
# `.dockerignore` drops every `*.wasm` and `*.onnx` so the CI images built from `./Dockerfile` stay
# small; BuildKit uses this Dockerfile's own ignore file instead, which re-admits the built `pkg/`
# directories and nothing else.

# Stage the packages that live outside the repository.
# These are published packages the modules load at runtime, provisioned by mise rather than built
# here, so this stage installs them from the repo's own pins and copies each one to the `/app` path
# the hub serves it from.
FROM debian:bookworm-slim AS deps
RUN bash <<'EOF'
set -euo pipefail
apt-get update
apt-get install -y --no-install-recommends bash bzip2 ca-certificates curl git gzip tar unzip
apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
EOF

# skipcq: DOK-DL4006
RUN curl -fsSL https://mise.run | sh
ENV HOME=/root
ENV PATH="/root/.local/bin:/root/.local/share/mise/shims:${PATH}"
WORKDIR /workspace
COPY .miserc.toml .miserc.toml
COPY .mise/ .mise/
RUN mise trust
ENV MISE_ENV=dart,dotnet,java,js,kotlin,python,r,rust,zig
RUN bash <<'EOF'
set -euo pipefail
mise install node
EOF

ENV SCENARIO_TOOLS="npm:onnxruntime-web http:pyodide"
RUN bash <<'EOF'
set -euo pipefail
# Word-splitting SCENARIO_TOOLS is intentional; it is a space-separated tool list.
# shellcheck disable=SC2086
mise install ${SCENARIO_TOOLS}
EOF

ENV STAGE_TOOL="npm:onnxruntime-web"
ENV STAGE_PACKAGE="onnxruntime-web"
ENV STAGE_DEST="/staged/app/node_modules/onnxruntime-web"
RUN bash <<'EOF'
set -euo pipefail
root="$(mise where "${STAGE_TOOL}")"
src="$(find -L "${root}" -type d -name "${STAGE_PACKAGE}" -exec test -f '{}/package.json' ';' -print -quit)"
if [ -z "${src}" ] && [ -f "${root}/package.json" ]; then
    src="${root}"
fi
if [ -z "${src}" ]; then
    echo "no ${STAGE_PACKAGE} package dir under the ${STAGE_TOOL} install at ${root}" >&2
    exit 1
fi
mkdir -p "$(dirname "${STAGE_DEST}")"
cp -rL "${src}" "${STAGE_DEST}"
EOF

ENV STAGE_TOOL="http:pyodide"
ENV STAGE_PACKAGE="pyodide"
ENV STAGE_DEST="/staged/app/node_modules/pyodide"
RUN bash <<'EOF'
set -euo pipefail
root="$(mise where "${STAGE_TOOL}")"
src="$(find -L "${root}" -type d -name "${STAGE_PACKAGE}" -exec test -f '{}/package.json' ';' -print -quit)"
if [ -z "${src}" ] && [ -f "${root}/package.json" ]; then
    src="${root}"
fi
if [ -z "${src}" ]; then
    echo "no ${STAGE_PACKAGE} package dir under the ${STAGE_TOOL} install at ${root}" >&2
    exit 1
fi
mkdir -p "$(dirname "${STAGE_DEST}")"
cp -rL "${src}" "${STAGE_DEST}"
EOF

# `hub` is a named build context, not a stage defined here.
# The generated compose file wires it to the hub service with `service:`, so compose builds the hub
# image first and hands the result over under this name. That is also why the version-tag rule is
# suppressed on the next line: hadolint reads `hub` as an untagged image, but there is no tag to give a
# build context, and the image it resolves to is pinned by the hub Dockerfile rather than here.
# hadolint ignore=DL3006
FROM hub

COPY --chown=10001:10001 services/ws-modules/face-detection/pkg /app/services/ws-modules/face-detection/pkg
COPY --chown=10001:10001 services/ws-modules/har1/pkg /app/services/ws-modules/har1/pkg
COPY --chown=10001:10001 services/ws-modules/pyface1/pkg /app/services/ws-modules/pyface1/pkg
COPY --chown=10001:10001 data/model-modules/model-face1/pkg /app/data/model-modules/model-face1/pkg
COPY --chown=10001:10001 data/model-modules/model-har-motion1/pkg /app/data/model-modules/model-har-motion1/pkg
COPY --chown=10001:10001 generated/python-ws/pkg /app/generated/python-ws/pkg
COPY --from=deps --chown=10001:10001 /staged/app/node_modules/onnxruntime-web /app/node_modules/onnxruntime-web
COPY --from=deps --chown=10001:10001 /staged/app/node_modules/pyodide /app/node_modules/pyodide
