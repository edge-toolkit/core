# AUTO-GENERATED by `et-cli` for the `default` scenario -- do not edit.
# Regenerate with `mise run regen-verification`.
#
# The hub image (services/ws-server/Dockerfile) carries no workflow modules at all, because which
# modules a deployment serves is a per-cluster decision. This image is that decision made concrete: it
# stages exactly the modules this cluster's agents declare, plus the packages those modules depend on,
# into the `/app` paths the hub already scans.
#
# This scenario consumes the project's releases, so its modules are fetched from the registry they are
# published to rather than copied from a checkout, and the image builds from the deployment directory
# alone.

# The released hub image, which this scenario layers its modules onto.
# `latest` because that is the one tag the hub is published under: it is assembled from each
# architecture's build, so a node of either architecture resolves it. That is why the rule against
# a `latest` base is suppressed on the next line.
# hadolint ignore=DL3007
FROM ghcr.io/edge-toolkit/core/et-ws-server:latest

LABEL org.opencontainers.image.source="https://github.com/edge-toolkit/core"

